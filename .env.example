# ============================================================
# Portal Bendahara — Environment Variables TEMPLATE
# ============================================================
# Salin file ini menjadi ".env" dan isi dengan nilai yang sesuai.
# File .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore).
# ============================================================

# URL base API backend (wajib diisi tim backend)
VITE_API_BASE_URL=https://keuangan.ade-setiawan.my.id

# Versi API (prefix path, default: v1)
VITE_API_VERSION=v1

# Nama aplikasi
VITE_APP_NAME=Portal Bendahara Keuangan Sekolah

# Mode: "mock" = data dummy lokal | "live" = API backend nyata
VITE_APP_MODE=mock
